{
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "docmap hook session-start" } ] }
    ],
    "PreToolUse": [
      { "matcher": "Read", "hooks": [ { "type": "command", "command": "docmap hook pre-read" } ] }
    ],
    "PostToolUse": [
      { "matcher": "Edit|Write", "hooks": [ { "type": "command", "command": "docmap hook post-edit" } ] }
    ]
  }
}
